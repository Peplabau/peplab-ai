# -----------------------------------------------------------------------------
# PEPLAB — peplab.ai deployment (separate Vercel project)
#
# Copy this repo, run:  bash deploy/peplab-ai/apply.sh
# Then copy this file to `.env` and set Supabase keys (same backend as .com.au).
# -----------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Open storefront — peplab.ai only (no login-only lock).
VITE_SITE_URL=https://peplab.ai
VITE_MAIN_APP_ORIGIN=https://peplab.ai
VITE_LOGIN_ONLY_HOSTS=

# Optional
# VITE_LANDING_SITE_URL=https://peplab.ai/landing
# VITE_MAIN_SITE_URL=https://peplab.ai

# Trustpilot TrustBox — optional legacy widgets (homepage now uses DB sync)
# VITE_TRUSTPILOT_BUSINESS_UNIT_ID=
# VITE_TRUSTPILOT_WIDGET_TOKEN=

# --- Trustpilot sync (Supabase Edge Function secrets — NOT VITE_) ---------------
# APIFY_TOKEN=
# APIFY_TRUSTPILOT_ACTOR_ID=spiders/trustpilot-scraper
# TRUSTPILOT_PROFILE_URL=https://www.trustpilot.com/review/peplab.com.au

# --- Research AI (admin CMS) --------------------------------------------------
# Edge Function `research-ai-parse` turns pasted/uploaded docs into research
# article fields (headings, body, FAQs, etc.). Keep the key SERVER-SIDE only:
#   Supabase → Edge Functions → Secrets → OPENAI_API_KEY=sk-...
# Optional: OPENAI_MODEL=gpt-4o-mini
# Deploy: supabase functions deploy research-ai-parse
# Never set VITE_OPENAI_API_KEY — it would ship in the browser bundle.

