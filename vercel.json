    { "source": "/product/bacteriostatic-water", "destination": "https://peplab.com.au/product/bac-water", "permanent": true },
    { "source": "/product/tb500", "destination": "https://peplab.com.au/product/tb-500", "permanent": true },
    { "source": "/product/hgh", "destination": "https://peplab.com.au/product/hgh-191aa", "permanent": true },
    { "source": "/product/epithalon", "destination": "https://peplab.com.au/product/epitalon", "permanent": true },
    { "source": "/product/bpc-tb-combo", "destination": "https://peplab.com.au/product/bpc-5mg-tb-5mg", "permanent": true },
    { "source": "/product/bpc-157-tb500", "destination": "https://peplab.com.au/product/bpc-5mg-tb-5mg", "permanent": true },
    { "source": "/product/bpc-157-tb-500", "destination": "https://peplab.com.au/product/bpc-5mg-tb-5mg", "permanent": true },
    { "source": "/product/gsh-glutathione", "destination": "https://peplab.com.au/product/glutathione", "permanent": true },
    { "source": "/product/melanotan-ii", "destination": "https://peplab.com.au/product/mt-2", "permanent": true },
    { "source": "/product/syringes-1ml-31g", "destination": "https://peplab.com.au/product/1ml-31g-6mm-syringes", "permanent": true },
    { "source": "/new-landing", "destination": "/landing", "permanent": true },
    { "source": "/shop", "has": [{ "type": "host", "value": "peplab.ai" }], "destination": "https://peplab.com.au/shop", "permanent": true },
    { "source": "/shop", "has": [{ "type": "host", "value": "www.peplab.ai" }], "destination": "https://peplab.com.au/shop", "permanent": true },
    { "source": "/product/:slug", "has": [{ "type": "host", "value": "peplab.ai" }], "destination": "https://peplab.com.au/product/:slug", "permanent": true },
    { "source": "/product/:slug", "has": [{ "type": "host", "value": "www.peplab.ai" }], "destination": "https://peplab.com.au/product/:slug", "permanent": true },
    { "source": "/admin", "has": [{ "type": "host", "value": "peplab.ai" }], "destination": "https://peplab.com.au/admin", "permanent": true },
    { "source": "/admin/:path*", "has": [{ "type": "host", "value": "peplab.ai" }], "destination": "https://peplab.com.au/admin/:path*", "permanent": true },
    { "source": "/admin", "has": [{ "type": "host", "value": "www.peplab.ai" }], "destination": "https://peplab.com.au/admin", "permanent": true },
    { "source": "/admin/:path*", "has": [{ "type": "host", "value": "www.peplab.ai" }], "destination": "https://peplab.com.au/admin/:path*", "permanent": true },
    { "source": "/((?!landing/?$)(?!.*\\.).+)", "has": [{ "type": "host", "value": "peplab.ai" }], "destination": "https://peplab.com.au/$1", "permanent": true },
    { "source": "/((?!landing/?$)(?!.*\\.).+)", "has": [{ "type": "host", "value": "www.peplab.ai" }], "destination": "https://peplab.com.au/$1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
