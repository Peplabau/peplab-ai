# -----------------------------------------------------------------------------
# PEPLAB — peplab.ai deployment (separate Vercel project)
#
# Copy this repo, run:  bash deploy/peplab-ai/apply.sh
# Then copy this file to `.env` and set Supabase keys (same backend as .com.au).
# -----------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Open storefront — peplab.ai only (no login-only lock).
VITE_SITE_URL=https://peplab.ai
VITE_MAIN_APP_ORIGIN=https://peplab.ai
VITE_LOGIN_ONLY_HOSTS=

# Optional
# VITE_LANDING_SITE_URL=https://peplab.ai/landing
# VITE_MAIN_SITE_URL=https://peplab.ai
